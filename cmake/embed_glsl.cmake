# Embeds glsl/*.{vert,frag,comp,glsl} into the library as a sorted
# {path, contents} table (src/embedded_glsl.h), so a host can build every
# program without a glsl/ directory on disk.
#
# Included from CMakeLists.txt, this file defines sh_renderer_embed_glsl().
# Run as a script (cmake -DGLSL_DIR=... -DOUTPUT=... -P embed_glsl.cmake), it
# writes the generated C++ file.

set(SH_RENDERER_GLSL_PATTERNS *.vert *.frag *.comp *.glsl)

if(NOT CMAKE_SCRIPT_MODE_FILE)
  # sh_renderer_embed_glsl(<target>): generates embedded_glsl.cpp in the
  # binary directory from the GLSL files in <source dir>/glsl and adds it,
  # with the embedded reader, to <target>.
  function(sh_renderer_embed_glsl target)
    set(glsl_dir "${CMAKE_CURRENT_SOURCE_DIR}/glsl")
    set(globs)
    foreach(pattern IN LISTS SH_RENDERER_GLSL_PATTERNS)
      list(APPEND globs "${glsl_dir}/${pattern}")
    endforeach()
    file(GLOB glsl_files CONFIGURE_DEPENDS ${globs})
    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/embedded_glsl.cpp")
    add_custom_command(
      OUTPUT "${output}"
      COMMAND "${CMAKE_COMMAND}" "-DGLSL_DIR=${glsl_dir}" "-DOUTPUT=${output}"
              -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
      DEPENDS ${glsl_files} "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
      COMMENT "Embedding GLSL sources"
      VERBATIM)
    add_custom_target(sh_renderer_embed_glsl DEPENDS "${output}")
    add_dependencies(${target} sh_renderer_embed_glsl)
    target_sources(${target} PRIVATE "${output}"
                                     "${CMAKE_CURRENT_SOURCE_DIR}/src/embedded_glsl.cpp")
    target_compile_definitions(${target} PUBLIC SH_RENDERER_EMBED_GLSL)
  endfunction()
  return()
endif()

# Script mode: write ${OUTPUT} from the GLSL files in ${GLSL_DIR}.
if(NOT GLSL_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "embed_glsl.cmake: GLSL_DIR and OUTPUT are required")
endif()

set(globs)
foreach(pattern IN LISTS SH_RENDERER_GLSL_PATTERNS)
  list(APPEND globs "${GLSL_DIR}/${pattern}")
endforeach()
file(GLOB glsl_files RELATIVE "${GLSL_DIR}" ${globs})
list(SORT glsl_files)

# Raw string literal pieces stay well under every compiler's literal limit
# (MSVC: 16380 bytes per piece); adjacent pieces concatenate.
set(chunk_size 4096)
set(delimiter "sh_glsl")

set(literals "")
set(entries "")
set(index 0)
foreach(name IN LISTS glsl_files)
  file(READ "${GLSL_DIR}/${name}" contents)
  string(FIND "${contents}" ")${delimiter}\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "embed_glsl.cmake: ${name} contains )${delimiter}\"")
  endif()
  string(LENGTH "${contents}" length)
  set(pieces "")
  set(offset 0)
  while(offset LESS length)
    string(SUBSTRING "${contents}" ${offset} ${chunk_size} piece)
    string(APPEND pieces "\n    R\"${delimiter}(${piece})${delimiter}\"")
    math(EXPR offset "${offset} + ${chunk_size}")
  endwhile()
  if(pieces STREQUAL "")
    set(pieces " \"\"")
  endif()
  string(APPEND literals "constexpr char kFile${index}[] =${pieces};\n")
  string(APPEND entries
         "    {\"glsl/${name}\", {kFile${index}, sizeof(kFile${index}) - 1}},\n")
  math(EXPR index "${index} + 1")
endforeach()

set(code "// Generated by cmake/embed_glsl.cmake from glsl/. Do not edit.
#include \"embedded_glsl.h\"

namespace sh_renderer {
namespace {

${literals}
constexpr EmbeddedFile kFiles[] = {
${entries}};

}  // namespace

std::span<const EmbeddedFile> EmbeddedGlslFiles() { return kFiles; }

}  // namespace sh_renderer
")

# Rewrite only on change, so dependents don't rebuild needlessly.
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL code)
  file(WRITE "${OUTPUT}" "${code}")
endif()
